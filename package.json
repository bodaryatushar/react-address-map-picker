{
  "name": "react-address-picker",
  "version": "0.1.0",
  "description": "A highly customizable React address picker component with Leaflet maps, Nominatim geocoding, and i18next support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "leaflet": "^1.9.0",
    "i18next": "^23.0.0 || ^24.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "i18next": { "optional": true },
    "react-i18next": { "optional": true }
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "leaflet": "^1.9.4",
    "i18next": "^23.16.8",
    "react-i18next": "^15.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "react",
    "address-picker",
    "map",
    "leaflet",
    "geocoding",
    "nominatim",
    "location-picker",
    "openstreetmap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tusharbodarya/react-address-picker"
  }
}
